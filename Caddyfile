# Caddyfile for Orbit — TRANSITION CONFIG
#
# Serves TWO things at once while the internal DNS record for orbit.hearst.com
# is still propagating:
#   1. The current site over HTTP on the existing domain (appsec.companynet.*),
#      via the :80 catch-all (matches any hostname).
#   2. orbit.hearst.com over HTTPS with the DigiCert cert — ready for the moment
#      DNS resolves. Scoped to :443 so it does NOT conflict with the :80 block.
#
# Cert files (mounted read-only from ./certs via docker-compose):
#   /etc/caddy/certs/orbit-fullchain.crt, /etc/caddy/certs/orbit.key
#
# WHEN DNS IS LIVE AND YOU WANT orbit HTTPS-ONLY:
#   - delete the ":80" block below
#   - change "orbit.hearst.com:443" to "orbit.hearst.com" (Caddy then serves 443
#     and auto-redirects HTTP->HTTPS)
#   - set FRONTEND_URL / VITE_API_URL to https://orbit.hearst.com and rebuild
#     the frontend

# Shared reverse-proxy routes, imported by both site blocks below.
# (X-Forwarded-For / X-Forwarded-Proto are set automatically by Caddy, so they
# are not listed here.)
(app_routes) {
    # Reverse proxy API requests to backend (must come before /)
    handle /api/* {
        reverse_proxy backend:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote}
        }
    }

    # Reverse proxy snapshot/static storage requests to backend
    handle /storage/* {
        reverse_proxy backend:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote}
        }
    }

    # Reverse proxy health check
    handle /health {
        reverse_proxy backend:3001
    }

    # Explicitly handle static assets (JS, CSS, images, etc.)
    handle /assets/* {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
        }
    }

    # Handle markdown files in docs directory (serve as static files)
    handle /docs/*.md {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
        }
    }

    # Handle /docs routes (let React Router handle them - for the Docs component)
    handle /docs* {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
        }
    }

    # Reverse proxy all other requests to frontend (must come last)
    handle {
        reverse_proxy frontend:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
        }
    }
}

# orbit.hearst.com over HTTPS (real DigiCert cert). Scoped to :443 so it
# coexists with the :80 catch-all below. Ready for when DNS resolves.
orbit.hearst.com:443 {
    tls /etc/caddy/certs/orbit-fullchain.crt /etc/caddy/certs/orbit.key
    import app_routes
}

# Current domain over HTTP (any hostname) — keeps appsec.companynet.* live
# until the orbit.hearst.com DNS record is in place.
:80 {
    import app_routes
}
