# Env file for the SECURITY-TEST instance (docker-compose.sectest.yml).
#
#   cp .env.sectest.example .env.sectest   # .env.sectest is gitignored
#   # then set the two origins to your server's IP and fill in the secrets
#
# Used two ways by the sectest compose file:
#   1. --env-file .env.sectest  -> interpolates ${...} in the compose file
#   2. backend env_file          -> injects backend runtime secrets into the container

# ---------------------------------------------------------------------------
# Public origins — set the IP to your server's LAN/VPN IP. Ports must match the
# published ports below. MUST stay http:// (not https://): that keeps the
# secure-cookie flag OFF so login works over the IP with no TLS cert.
# ---------------------------------------------------------------------------
# Where you point your browser (the frontend). Drives the backend CORS allowlist.
FRONTEND_ORIGIN=http://10.0.0.5:8080
# The backend API origin, baked into the frontend bundle at BUILD time. Because
# it's baked in, re-run `up --build` (or `build frontend`) if you change it.
BACKEND_ORIGIN=http://10.0.0.5:8081

# Published host ports (pick anything free; these avoid prod's 80/443/3000/3001/5432).
# Keep them consistent with the port in each *_ORIGIN above.
FRONTEND_HTTP_PORT=8080
BACKEND_HTTP_PORT=8081

# ---------------------------------------------------------------------------
# PostgreSQL for the test instance (separate DB from prod; separate volume).
# ---------------------------------------------------------------------------
POSTGRES_USER=sectest
POSTGRES_PASSWORD=change-me-different-from-prod
POSTGRES_DB=appsec_catalog_sectest

# ---------------------------------------------------------------------------
# Backend runtime secrets (injected into the container via env_file).
# ---------------------------------------------------------------------------
# Required in production mode. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32
# AES-256-GCM key for stored integration secrets (64 hex chars). openssl rand -hex 32
INTEGRATIONS_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Okta SSO / GitHub intentionally left blank -> app falls back to email+password
# login (an IP has no valid Okta redirect URI). Seed the one admin with:
#   docker compose -p appsec-sectest -f docker-compose.sectest.yml exec backend \
#     node scripts/create-admin.js you@example.com 'a-strong-password'
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
