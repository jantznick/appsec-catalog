# Backend Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://appsec:appsec_password@localhost:5432/appsec_catalog

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# Session Secret (generate a random string for production)
SESSION_SECRET=your-session-secret-here
ADMIN_EMAILS=admin@example.com

# AES-256-GCM key for integration API secrets (64 hex chars = 32 bytes), e.g. openssl rand -hex 32
# (An empty value injected by Docker for this name would override .env; dotenv does not overwrite set vars.)
INTEGRATIONS_ENCRYPTION_KEY=

# Optional: local repo path used by the admin Product Updates screen to show recent git commits.
# In Docker Compose this defaults to the read-only /repo mount.
PRODUCT_UPDATES_GIT_WORKDIR=

# GitHub App integration (users connect their own GitHub; repos linked to applications).
# Full walkthrough: ../GITHUB_INTEGRATION.md
# Register a GitHub App at https://github.com/settings/apps with:
#   - Callback URL: <BACKEND_ORIGIN>/api/integrations/scm/callback
#   - "Request user authorization (OAuth) during installation" enabled
#   - "Where can this GitHub App be installed?" = Any account (so users can install it themselves)
#   - Repository permissions (read-only): Contents, Metadata
# Requires INTEGRATIONS_ENCRYPTION_KEY above (the stored user token is encrypted with it).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# App private key PEM. Single-line: base64-encode the whole PEM, or use \n escapes.
GITHUB_APP_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Okta SSO (OIDC Authorization Code + PKCE)
# ---------------------------------------------------------------------------
# Create an OIDC "Web Application" in the Okta Admin Console and paste the
# values below. When these are unset, Okta SSO is simply disabled and the app
# falls back to password/magic-code login only.
#
# Issuer of your Okta authorization server, e.g.
#   https://yourcompany.okta.com/oauth2/default   (custom authorization server)
#   https://yourcompany.okta.com                   (org authorization server)
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Must EXACTLY match a "Sign-in redirect URI" configured on the Okta app.
#   Dev:  http://localhost:5000/api/auth/okta/callback
#   Prod: https://YOUR-DOMAIN/api/auth/okta/callback
OKTA_REDIRECT_URI=http://localhost:5000/api/auth/okta/callback
# Space-delimited scopes. Default is "openid email profile".
# Add "groups" ONLY if you opt into group-based admin mapping (OKTA_ADMIN_GROUP).
OKTA_SCOPES=openid email profile
# Optional / advanced: Okta group name whose members become app admins (via the
# ID token groups claim). Leave BLANK to keep admin managed manually through
# ADMIN_EMAILS / the isAdmin flag (the default). If set, also add "groups" to
# OKTA_SCOPES and configure a groups claim on the authorization server.
OKTA_ADMIN_GROUP=
# Optional: where Okta returns the browser after single-logout. Must be listed
# as a "Sign-out redirect URI" on the Okta app.
#   Dev:  http://localhost:3000
#   Prod: https://YOUR-DOMAIN
OKTA_POST_LOGOUT_REDIRECT_URI=
# Optional escape hatch: allow linking an Okta identity onto a PRE-EXISTING local
# account by email even when the ID token does not assert email_verified=true.
# Only enable if your corporate Okta directory centrally manages (and you trust)
# user email addresses. Default (unset/false) keeps the safe, verified-only guard.
OKTA_ALLOW_UNVERIFIED_EMAIL_LINK=
