# Root environment file for docker-compose.
#
# Copy to `.env` (which is gitignored) and adjust for your deployment:
#   cp .env.example .env
#
# These values are interpolated by docker-compose.yml. The root .env is ALSO
# loaded into the backend container (env_file), so FRONTEND_URL / NODE_ENV set
# here drive backend behavior too. Application SECRETS (SESSION_SECRET, OKTA_*,
# GITHUB_*, INTEGRATIONS_ENCRYPTION_KEY, ...) live in backend/.env — see
# backend/.env.example.

# ---------------------------------------------------------------------------
# Public URL of the deployment — the single source of truth for the domain.
# ---------------------------------------------------------------------------
# Drives, from this one value:
#   - backend CORS allowlist, secure-cookie flag, and session cookie domain
#     (backend/server.js derives all three from FRONTEND_URL)
#   - the API base URL baked into the frontend bundle at BUILD time
#     (docker-compose passes it as the VITE_API_URL build arg)
#
# Because the frontend bakes this in at build time, you MUST rebuild the
# frontend image when it changes:  docker compose build frontend
#
# Production example: https://orbit.hearst.com
FRONTEND_URL=http://localhost:3000

# `production` enables secure-cookie enforcement and REQUIRES SESSION_SECRET
# to be set in backend/.env (the backend refuses to start otherwise).
NODE_ENV=production

# ---------------------------------------------------------------------------
# PostgreSQL (used by the postgres service and the backend DATABASE_URL)
# ---------------------------------------------------------------------------
POSTGRES_USER=appsec
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=appsec_catalog
# Host port to expose Postgres on (container port is always 5432).
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Admin-triggered deploys (backend launches a short-lived docker runner)
# ---------------------------------------------------------------------------
# Absolute path to this repo ON THE HOST VM. Mounted read-only into the backend
# and used as the working directory for admin-initiated redeploys.
DEPLOY_HOST_WORKDIR=/opt/appsec-catalog
# Image used to run deploy commands (needs the docker CLI).
DEPLOY_RUNNER_IMAGE=docker:cli
# Repo path inside the backend container for the Product Updates commit view.
PRODUCT_UPDATES_GIT_WORKDIR=/repo

# ---------------------------------------------------------------------------
# Optional: dogfooding deploy records (POST /api/deployment-tokens).
# Leave blank unless this instance reports its own deploys to a catalog.
# ---------------------------------------------------------------------------
APPSEC_CATALOG_API_URL=
APPSEC_CATALOG_DEPLOYMENT_TOKEN=
APPSEC_CATALOG_DEPLOY_ENV=prod
APPSEC_CATALOG_FRONTEND_APP_ID=
APPSEC_CATALOG_BACKEND_APP_ID=
