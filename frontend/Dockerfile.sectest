# Frontend Dockerfile for the SECURITY-TEST instance.
#
# Identical to the prod Dockerfile EXCEPT it bakes the API base URL into the
# bundle from a build arg. The sectest compose file always passes VITE_API_URL
# (= PUBLIC_ORIGIN), so the browser calls the API same-origin through Caddy on
# the IP. Kept separate so the prod Dockerfile / prod build stays untouched.
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Bake the API base URL. The sectest compose always supplies this build arg.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Production stage
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

RUN echo 'server { \
    listen 3000; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    autoindex off; \
    location ~ ^/docs/.*\.md$ { \
        try_files $uri =404; \
        add_header Content-Type "text/markdown; charset=utf-8"; \
        add_header Access-Control-Allow-Origin "*"; \
    } \
    location = /docs/ { \
        try_files /index.html =404; \
    } \
    location /docs { \
        try_files $uri /index.html; \
    } \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
